# env.example — copy to .env and fill in your values.
# Values shown here are the defaults used when no env var is set.
# Do NOT commit a real .env file to version control.

# ============================================================
# MongoDB
# ============================================================
# Override to use a separate database during development/testing.
# Example: final_dev, test_db, etc.
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=midterm_data_pipeline
# Dev runs: set to .dev_reports so reports/ in the repo stays untouched
REPORTS_DIR=

# ============================================================
# PySpark
# ============================================================
# Local temp directory for Spark shuffle/sort spill.
# Leave empty to use M:/spark-temp (if drive M: exists) or system temp.
SPARK_LOCAL_DIR=

# ============================================================
# Final Project API (FastAPI / Uvicorn)
# ============================================================
API_HOST=127.0.0.1
API_PORT=8000

# ============================================================
# APScheduler (materialized-view refresh jobs)
# ============================================================
# Set to "true" to enable background scheduled jobs when the API starts.
SCHEDULER_ENABLED=false
